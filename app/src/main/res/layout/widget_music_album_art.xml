<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_music_widget_album_art"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_album_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_music_widget_album_art" />

    <LinearLayout
        android:id="@+id/widget_album_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <FrameLayout
                android:id="@+id/widget_album_art_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal">

                <ImageView
                    android:id="@+id/widget_album_art"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="Album Art"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bg_music_widget_artwork_placeholder" />

                <FrameLayout
                    android:id="@+id/widget_album_favorite_container"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp">

                    <ImageView
                        android:id="@+id/widget_album_favorite_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_music_widget_circle"
                        android:tint="#73000000" />

                    <ImageView
                        android:id="@+id/widget_album_favorite_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Favorite"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_media_favorite_off"
                        android:tint="#FFFFFFFF" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_album_text_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/widget_album_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Neon Horizon"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_album_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aurora Synth • Midnight Odyssey"
                android:textColor="#FF4CC9F0"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_album_controls_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/widget_album_shuffle_container"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/widget_album_shuffle_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_music_widget_circle"
                        android:tint="#404CC9F0"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/widget_album_shuffle_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Shuffle Off"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_media_shuffle_off"
                        android:tint="#B3FFFFFF" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_album_prev_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous track"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_skip_previous"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2">

                <FrameLayout
                    android:id="@+id/widget_album_play_pause_container"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/widget_album_play_pause_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_music_widget_circle"
                        android:tint="#FF4CC9F0" />

                    <ImageView
                        android:id="@+id/widget_album_play_pause_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Play"
                        android:padding="13dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_media_play"
                        android:tint="#FF101018" />
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_album_next_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next track"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_skip_next"
                    android:tint="#FFFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/widget_album_repeat_container"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center">

                    <ImageView
                        android:id="@+id/widget_album_repeat_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_music_widget_circle"
                        android:tint="#404CC9F0"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/widget_album_repeat_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Repeat Off"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_media_repeat_off"
                        android:tint="#B3FFFFFF" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
