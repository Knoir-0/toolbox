<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_todo_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_screen_recorder_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_todo_widget_card" />

    <LinearLayout
        android:id="@+id/widget_screen_recorder_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/widget_screen_recorder_badge"
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/widget_screen_recorder_badge_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/bg_music_widget_circle"
                android:tint="#FF5A3472" />

            <ImageView
                android:id="@+id/widget_screen_recorder_badge_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_screen_share"
                android:tint="#FFDDB9F6" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_screen_recorder_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_screen_recorder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Screen Recorder"
                android:textColor="#FFE7E1E6"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_screen_recorder_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Full screen • 1080p"
                android:textColor="#FFCDC4CF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3 Recording Buttons matching ScreenRecorderScreen & AudioRecorderScreen: [Device + Mic] [Primary Mic] [Device Audio] -->
        <LinearLayout
            android:id="@+id/widget_screen_recorder_buttons_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Left: Smaller Device + Microphone (Both) Button -->
            <FrameLayout
                android:id="@+id/widget_screen_recorder_both_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Record screen with device and microphone audio">

                <ImageView
                    android:id="@+id/widget_screen_recorder_both_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FF4E4356" />

                <ImageView
                    android:id="@+id/widget_screen_recorder_both_button_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_device_and_mic"
                    android:tint="#FFEFDEF5" />
            </FrameLayout>

            <!-- 2. Middle: Primary Larger Microphone Button -->
            <FrameLayout
                android:id="@+id/widget_screen_recorder_record_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Record screen with microphone audio">

                <ImageView
                    android:id="@+id/widget_screen_recorder_record_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FFDDB9F6" />

                <ImageView
                    android:id="@+id/widget_screen_recorder_record_button_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_mic"
                    android:tint="#FF2E1142" />
            </FrameLayout>

            <!-- 3. Right: Smaller Device Audio Button -->
            <FrameLayout
                android:id="@+id/widget_screen_recorder_device_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Record screen with internal device audio">

                <ImageView
                    android:id="@+id/widget_screen_recorder_device_button_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FF4E4356" />

                <ImageView
                    android:id="@+id/widget_screen_recorder_device_button_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_widget_phone_android"
                    android:tint="#FFEFDEF5" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
