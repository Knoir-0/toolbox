<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_texture_column_outer"
    android:layout_width="match_parent"
    android:layout_height="76dp">

    <!--
        Horizontal row inside the vertically scrollable ListView that lays out 1 to 4 texture
        cards side-by-side depending on the widget's width.
    -->
    <LinearLayout
        android:id="@+id/widget_texture_column_inner"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="2dp">

        <!-- Column 1 Slot -->
        <FrameLayout
            android:id="@+id/widget_texture_slot_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingTop="1dp"
            android:paddingEnd="2dp"
            android:paddingBottom="1dp">

            <ImageView
                android:id="@+id/widget_texture_slot_1_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_todo_widget_item" />

            <TextView
                android:id="@+id/widget_texture_slot_1_label"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="None"
                android:textColor="#FFE7E1E6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Column 2 Slot (Shown when widget width supports 2+ columns) -->
        <FrameLayout
            android:id="@+id/widget_texture_slot_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingTop="1dp"
            android:paddingEnd="2dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_texture_slot_2_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_todo_widget_item" />

            <TextView
                android:id="@+id/widget_texture_slot_2_label"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Fuzzy"
                android:textColor="#FFE7E1E6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Column 3 Slot (Shown when widget width supports 3+ columns) -->
        <FrameLayout
            android:id="@+id/widget_texture_slot_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingTop="1dp"
            android:paddingEnd="2dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_texture_slot_3_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_todo_widget_item" />

            <TextView
                android:id="@+id/widget_texture_slot_3_label"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Fade"
                android:textColor="#FFE7E1E6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Column 4 Slot (Shown when widget width supports 4 columns) -->
        <FrameLayout
            android:id="@+id/widget_texture_slot_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingTop="1dp"
            android:paddingEnd="2dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_texture_slot_4_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_todo_widget_item" />

            <TextView
                android:id="@+id/widget_texture_slot_4_label"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="Concentric"
                android:textColor="#FFE7E1E6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
