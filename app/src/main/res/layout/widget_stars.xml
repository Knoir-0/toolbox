<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_todo_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_stars_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_todo_widget_card" />

    <LinearLayout
        android:id="@+id/widget_stars_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/widget_stars_sign_badge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/widget_stars_sign_badge_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/bg_music_widget_circle"
                android:tint="#FF5A3472" />

            <TextView
                android:id="@+id/widget_stars_sign_glyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="♉"
                android:textColor="#FFDDB9F6"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_stars_text_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_stars_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Taurus • Luminous"
                    android:textColor="#FFE7E1E6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_stars_moon_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="🌕 Full Moon"
                    android:textColor="#FFDDB9F6"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_stars_mantra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Trust the quiet pull of your intuition today."
                android:textColor="#FFE7E1E6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_stars_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="☉ Taurus • ☽ Leo • ↑ Virgo • Lucky #7"
                android:textColor="#FFCAC4CF"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_stars_next_sign_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Next zodiac sign">

            <ImageView
                android:id="@+id/widget_stars_next_sign_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/bg_music_widget_circle"
                android:tint="#FF5A3472" />

            <ImageView
                android:id="@+id/widget_stars_next_sign_button_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_widget_refresh"
                android:tint="#FFDDB9F6" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
