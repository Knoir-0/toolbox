<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_music_widget_mini_bar"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/widget_mini_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/bg_music_widget_mini_bar" />

        <LinearLayout
            android:id="@+id/widget_mini_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp">

            <ImageView
                android:id="@+id/widget_mini_album_art"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="Album Art"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_music_widget_artwork_placeholder" />

            <LinearLayout
                android:id="@+id/widget_mini_text_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Neon Horizon"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_mini_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Aurora Synth • Midnight Odyssey"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_mini_favorite_container"
                android:layout_width="38dp"
                android:layout_height="38dp">

                <ImageView
                    android:id="@+id/widget_mini_favorite_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#404CC9F0"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/widget_mini_favorite_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Favorite"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_favorite_off"
                    android:tint="#CCFFFFFF" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_mini_prev_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous track"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_media_skip_previous"
                android:tint="#FFFFFFFF" />

            <FrameLayout
                android:id="@+id/widget_mini_play_pause_container"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

                <ImageView
                    android:id="@+id/widget_mini_play_pause_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FF4CC9F0" />

                <ImageView
                    android:id="@+id/widget_mini_play_pause_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Play"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_play"
                    android:tint="#FF101018" />
            </FrameLayout>

            <ImageView
                android:id="@+id/widget_mini_next_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next track"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_media_skip_next"
                android:tint="#FFFFFFFF" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
