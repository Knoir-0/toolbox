<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_todo_widget_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_todo_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_todo_widget_card" />

    <LinearLayout
        android:id="@+id/widget_todo_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:id="@+id/widget_todo_header"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/widget_todo_header_badge"
                android:layout_width="34dp"
                android:layout_height="34dp">

                <ImageView
                    android:id="@+id/widget_todo_header_badge_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FF5A3472" />

                <ImageView
                    android:id="@+id/widget_todo_header_badge_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_todo_widget_checklist"
                    android:tint="#FFDDB9F6" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/widget_todo_header_text_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_todo_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="To Do"
                    android:textColor="#FFE7E1E6"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_todo_subtext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="0 tasks • 0 completed today"
                    android:textColor="#FFCDC4CF"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Scrollable Task List & Empty View Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_todo_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="68dp"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/widget_todo_empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="12dp"
                android:paddingEnd="24dp"
                android:paddingBottom="44dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/widget_todo_empty_badge_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/bg_music_widget_circle"
                        android:tint="#805A3472" />

                    <ImageView
                        android:id="@+id/widget_todo_empty_badge_icon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_todo_widget_circle_checked"
                        android:tint="#FFDDB9F6" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_todo_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="All caught up!"
                    android:textColor="#FFE7E1E6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_todo_empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="Tap + or checklist to take a note"
                    android:textColor="#FFCDC4CF"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Overlay: Undo Completion Toast Pill (left/start) & Two Floating FABs (bottom-right) -->
    <LinearLayout
        android:id="@+id/widget_todo_bottom_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- Undo Completion Toast Banner -->
        <FrameLayout
            android:id="@+id/widget_todo_undo_toast_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_todo_undo_toast_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_todo_widget_toast" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/widget_todo_undo_toast_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Task completed"
                    android:textColor="#FFE7E1E6"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/widget_todo_undo_button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_todo_widget_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/widget_todo_undo_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_todo_widget_undo"
                        android:tint="#FFF3DAFF" />

                    <TextView
                        android:id="@+id/widget_todo_undo_button_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Undo"
                        android:textColor="#FFF3DAFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_todo_bottom_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Two Floating FABs at Bottom Right: Checklist FAB and Plus (+) FAB -->
        <LinearLayout
            android:id="@+id/widget_todo_fabs_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom|end"
            android:orientation="horizontal">

            <!-- Checklist Floating FAB -> Opens Notes tool to create a new checklist -->
            <FrameLayout
                android:id="@+id/widget_todo_fab_checklist_container"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:id="@+id/widget_todo_fab_checklist_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FF4E4356" />

                <ImageView
                    android:id="@+id/widget_todo_fab_checklist"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="New checklist in Notes"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_todo_widget_checklist"
                    android:tint="#FFEFDEF5" />
            </FrameLayout>

            <!-- Plus (+) Floating FAB -> Opens Notes tool to take a new note -->
            <FrameLayout
                android:id="@+id/widget_todo_fab_plus_container"
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageView
                    android:id="@+id/widget_todo_fab_plus_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/bg_music_widget_circle"
                    android:tint="#FF5A3472" />

                <ImageView
                    android:id="@+id/widget_todo_fab_plus"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="New note in Notes"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_media_add"
                    android:tint="#FFF3DAFF" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
